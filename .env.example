# Copy to .env for local development. Replace the JWT placeholder before starting.
NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# Local MongoDB. Use a separate production database with backups in deployment.
MONGO_URI=mongodb://127.0.0.1:27017/afroeat

# Replace with a randomly generated secret of at least 32 characters.
# The backend rejects this template value until it is changed.
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_OF_32_PLUS_CHARACTERS

# Comma-separated exact web origins for production. Development relaxes CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional: card payments stay unavailable unless test Stripe credentials are configured.
# Never put these secret keys in the mobile app or any EXPO_PUBLIC_* variable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used for Checkout return URLs and app deep links.
APP_DEEP_LINK_SCHEME=afroeat
PUBLIC_WEB_URL=http://localhost:8081
