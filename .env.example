# Copie vers .env en local. Ne jamais committer le vrai fichier .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/afroeat
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Clés Stripe serveur uniquement, jamais dans l'application mobile.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Les versements Connect sont bloqués par défaut.
STRIPE_CONNECT_PAYOUTS_ENABLED=false
STRIPE_PLATFORM_COUNTRY=
STRIPE_CONNECT_COUNTRIES=
STRIPE_CONNECT_CROSS_BORDER_COUNTRIES=

# Taux en points de base, indexés par devise; exemple non activé:
# {"EUR":{"commissionBps":1200,"courierPayoutBps":7000},"CHF":{"commissionBps":1200,"courierPayoutBps":7000}}
MARKETPLACE_RATES_JSON=

# URLs publiques requises pour le parcours Stripe Connect.
PUBLIC_API_URL=https://api.example.invalid
PUBLIC_WEB_URL=https://afroeat.example.invalid

CORS_ORIGINS=http://localhost:8081
ALLOW_PARTNER_APPLICATIONS=true
APP_DEEP_LINK_SCHEME=afroeat
