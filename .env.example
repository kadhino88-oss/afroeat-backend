# Copy to .env for local development. Replace the JWT placeholder before starting.
NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# Local MongoDB. Use a separate production database with backups in deployment.
MONGO_URI=mongodb://127.0.0.1:27017/afroeat

# Set AFROEAT_DEPLOY_ENV=production only on the production API. The API then
# refuses to start unless this exact database name matches the connected MongoDB.
AFROEAT_DEPLOY_ENV=development
AFROEAT_MONGO_DB_NAME=

# Replace with a randomly generated secret of at least 32 characters.
# The backend rejects this template value until it is changed.
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_OF_32_PLUS_CHARACTERS

# Comma-separated exact web origins for production. Development relaxes CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional: card payments stay unavailable unless test Stripe credentials are configured.
# Never put these secret keys in the mobile app or any EXPO_PUBLIC_* variable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret of the separate Stripe "Connected accounts" webhook endpoint (POST /api/payments/webhook/connect).
# Without it that endpoint answers 400 and ignores every call.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Used for Checkout return URLs and app deep links.
APP_DEEP_LINK_SCHEME=afroeat
PUBLIC_WEB_URL=http://localhost:8081


# Stripe Connect: disabled until end-to-end tests and account/country review are complete.
STRIPE_CONNECT_PAYOUTS_ENABLED=false
STRIPE_PLATFORM_COUNTRY=
STRIPE_CONNECT_COUNTRIES=
STRIPE_CONNECT_CROSS_BORDER_COUNTRIES=

# Shared secret for scheduled jobs (POST /api/payments/connect/retry-payouts and
# POST /api/payments/ledger/reconcile-daily, header `Authorization: Bearer <CRON_SECRET>`).
# Use a long random value; those endpoints refuse every call while it is empty.
CRON_SECRET=

# Optional: address that receives the daily ledger reconciliation alert (status "mismatch" or a failed run;
# at most one e-mail per day and status). Falls back to PARTNER_NOTIFY_EMAIL, otherwise no alert is sent.
# Sending needs RESEND_API_KEY and MAIL_FROM (see utils/mailer.js); the alert never changes the cron response.
ALERT_EMAIL=

# Basis points per currency; example only, do not enable before finance approval.
# {"EUR":{"commissionBps":1200,"courierPayoutBps":7000},"CHF":{"commissionBps":1200,"courierPayoutBps":7000}}
MARKETPLACE_RATES_JSON=

# Public callback URLs used by Stripe Connect onboarding.
PUBLIC_API_URL=https://api.example.invalid

# Optionnel: permet au script e2e de vérifier le nom de la base via /health (16 caractères minimum, identique côté serveur et script).
HEALTH_DETAILS_TOKEN=

# Optionnel: date ISO à partir de laquelle la 2FA devient obligatoire pour les admins (délai de grâce).
ADMIN_2FA_ENFORCE_AFTER=

# Espèces : en vraie production elles restent FERMÉES tant que CASH_PAYMENTS_ENABLED n'est pas "true"
# (il faut pouvoir suivre et solder la caisse des partenaires). Hors production : toujours ouvertes.
CASH_PAYMENTS_ENABLED=
# Plafond d'une commande en espèces encaissée par un livreur (défaut 60, même nombre quelle que soit la devise).
CASH_COURIER_MAX_TOTAL=

# Rayon de livraison par défaut (km) quand le commerce n'a pas fixé le sien (défaut 10). Mesuré à vol d'oiseau
# entre le commerce et l'adresse du client géocodée par le serveur ; si le géocodage échoue, la commande passe.
DEFAULT_DELIVERY_RADIUS_KM=

# Délais d'annulation automatique (minutes, avec remboursement si déjà payé) :
# restaurant sans réponse (défaut 15), commande confirmée jamais préparée (défaut 20), paiement non finalisé (défaut 60).
ORDER_ACCEPT_TIMEOUT_MIN=
ORDER_PREPARE_TIMEOUT_MIN=
ORDER_UNPAID_TIMEOUT_MIN=

# Candidatures partenaires : adresse qui reçoit chaque nouvelle candidature (e-mail via Resend), et origines autorisées
# pour la connexion administrateur (ex. https://afroeat-admin.vercel.app).
PARTNER_NOTIFY_EMAIL=
ADMIN_WEB_ORIGINS=
# Clé de chiffrement des pièces d'identité des partenaires (obligatoire : sans elle l'envoi de documents est refusé).
# Générer une valeur aléatoire longue ; ne jamais la changer sans migrer les documents existants.
DOCUMENT_ENCRYPTION_KEY=

# Recherche de lieux en direct (secours quand la base ne contient rien autour de l'utilisateur) : serveurs Overpass
# (OpenStreetMap) essayés en parallèle, adresses https séparées par des virgules. Vide = liste par défaut.
OVERPASS_ENDPOINTS=
