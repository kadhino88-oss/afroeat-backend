{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{config,controllers,data,middleware,models,routes,utils}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/payments/connect/retry-payouts",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/payments/ledger/reconcile-daily",
      "schedule": "0 3 * * *"
    }
  ]
}
